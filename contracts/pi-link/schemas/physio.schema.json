{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "physio",
  "type": "object",
  "required": [
    "watch_connected",
    "t"
  ],
  "additionalProperties": false,
  "properties": {
    "watch_connected": {
      "type": "boolean"
    },
    "hr_bpm": {
      "type": [
        "number",
        "null"
      ]
    },
    "rr_ms": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 8
    },
    "hrv_state": {
      "enum": [
        "warmup",
        "valid",
        "degraded",
        "bad",
        "stale"
      ]
    },
    "rmssd_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "quality": {
      "enum": [
        "good",
        "degraded",
        "bad"
      ]
    },
    "t": {
      "type": "number",
      "description": "UTC epoch seconds in phone time (v1.3)"
    },
    "worn": {
      "type": "boolean"
    },
    "hr_baseline_bpm": {
      "type": [
        "number",
        "null"
      ]
    },
    "hr_delta_bpm": {
      "type": [
        "number",
        "null"
      ]
    },
    "hr_trend_bpm_per_10min": {
      "type": [
        "number",
        "null"
      ]
    },
    "t_src": {
      "enum": [
        "phone",
        "pi"
      ]
    }
  }
}
