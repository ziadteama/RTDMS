<?xml version="1.0"?>
<!--
  RR Check: step 2 of the Garmin plan. A minimal watch app that only proves the Forerunner 265
  delivers beat-to-beat (RR) intervals from its wrist sensor to a Connect IQ app. No Bluetooth yet.
  Permission "Sensor": heart rate + Sensor.registerSensorDataListener (heartBeatIntervals).
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="d4d9e5f1-3f06-4d3b-ac28-cfc377611be3" type="watch-app" name="@Strings.AppName"
            entry="RrCheckApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
