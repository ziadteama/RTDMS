.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Weights and exports are regenerated by scripts/ (see README) and stay out of git, EXCEPT the
# shipped release models listed below: they need ~150 GB of datasets and a GPU to retrain, so a
# fresh clone gets them ready to run (models/README.md has the model card and checksums).
models/*
!models/.gitkeep
!models/README.md
!models/det_v2d_ir_512_ncnn_model/
!models/det_v2d_ir_512_det_aciq_mixed_ncnn_model/
!models/det_v2d_ir_512.onnx
!models/det_v2d_ir_512.pt
!models/det_v2h_fish_512_ncnn_model/
!models/det_v2h_fish_512.pt
!models/yolo26n_pose_320_ncnn_model/
runs/

# Recordings, datasets, event logs and calibration captures stay on the machine.
data/
logs/
*.jsonl
bench_*.json

# Per-camera calibration is produced on the rig, not shipped.
configs/camera_fisheye.yaml

# Text encoder Ultralytics downloads into the working dir for YOLOE prompts.
/mobileclip*.ts

# Ultralytics download cache (CLIP text encoder, AMP-check weights) written to the working dir.
/weights/
# Teacher / base weights Ultralytics downloads into the working dir (yolo26m, -pose, YOLO-World).
/*.pt

# Live-test summaries (scripts/live.py --guided): local results, not shared by default.
reports/
